# Vast.ai GPU: copy to /workspace/incidentlens/worker.env; chmod 600.
# Used by BOTH api.gpu_media and backend.gpu_worker.
APP_ENV=production
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=https://c4-app-076.vercel.app
DATABASE_CLOUD=true
# Must be the SAME database as the Render API, including auth/session tables.
DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
INCIDENT_STORAGE_DIR=/workspace/incidentlens-media
# Must remain empty on Vast: media is local here; no proxy back to itself.
GPU_MEDIA_BASE_URL=
QWEN_RUNTIME=ollama
# Ollama is already managed on the GPU; do not launch a second local runtime.
QWEN_REMOTE_OLLAMA=true
QWEN_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
QWEN_OLLAMA_MODEL=qwen3.5:9b
QWEN_REASONING_EFFORT=none
QWEN_ARTIFACT_SUBDIR=output
QWEN_PROMPT_PATH=/workspace/incidentlens/backend/data/promt.txt
QWEN_LOG_PROMPT_PATH=/workspace/incidentlens/backend/prompts/ollama_incident.txt
QWEN_SUMMARY_PROMPT_PATH=/workspace/incidentlens/backend/prompts/video_summary.txt
QWEN_VIDEO_SUMMARY=true
QWEN_OUTPUTS_PATH=/workspace/incidentlens-logs/qwen-output.txt
RUNTIME_LOG_DIR=/workspace/incidentlens-logs/runtime
WORKER_POLL_S=10
QWEN_TIMEOUT_S=1800
# Existing telemetry profile, calibrated on a supplied recording only.
# Recalibrate on the team's dataset before treating these as general thresholds.
QWEN_TRIGGER_DECELERATION=22
QWEN_BRAKING_CONFIRMATION_S=0.08
QWEN_FLAG_ONLY=true
QWEN_TEMPORAL_CONTEXT=true
# Temporal context requires exactly six frames and cannot combine with two-stage.
QWEN_BATCH_FRAMES=6
QWEN_TWO_STAGE=false
LANGCHAIN_TRACING_V2=false
LOG_LEVEL=INFO
