# IncidentLens API on Render. Set these in Render Environment, not Vercel.
# Replace placeholders; never commit real database credentials or SSH keys.
APP_ENV=production
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=https://c4-app-076.vercel.app
DATABASE_CLOUD=true
DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'

# V1 media lives on Vast.ai. Render forwards selected media routes through SSH.
GPU_MEDIA_BASE_URL=http://127.0.0.1:18000
GPU_SSH_TARGET=root@REPLACE_WITH_VAST_SSH_HOST
GPU_SSH_PORT=REPLACE_WITH_VAST_SSH_PORT
# Required Render secrets: private key and verified known_hosts entry.
# GPU_SSH_PRIVATE_KEY accepts real newlines or literal \n sequences.
GPU_SSH_PRIVATE_KEY=
GPU_SSH_KNOWN_HOSTS=

# The API does not run inference or a worker. These keep Settings consistent.
QWEN_RUNTIME=ollama
QWEN_REMOTE_OLLAMA=true
QWEN_OLLAMA_MODEL=qwen3.5:9b
QWEN_REASONING_EFFORT=none
QWEN_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
QWEN_ARTIFACT_SUBDIR=output
INCIDENT_STORAGE_DIR=./backend/data/incidents
RUNTIME_LOG_DIR=./logs/runtime
LOG_LEVEL=INFO

# Optional tracing. Enable only after supplying a valid LangSmith key.
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=incidentlens

# Development AI usage logging is separate from runtime inference.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
