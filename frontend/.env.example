# Vercel project root: frontend/. Redeploy after changing build-time variables.
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_V2_WORKSPACE=false
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_V2_BASE_URL=/api/v2
# Render origin only. Do not append /api/v1; never use localhost on Vercel.
BACKEND_INTERNAL_URL=https://incidentlens-esot.onrender.com
